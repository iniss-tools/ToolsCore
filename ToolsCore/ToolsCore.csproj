<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>ToolsCore</RootNamespace>
		<AssemblyName>ToolsCore</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<LangVersion>default</LangVersion>
	</PropertyGroup>
	<ItemGroup>
		<!-- len pre Rider ([UsedImplicitly]); atributy su [Conditional], za behu sa DLL nepotrebuje -->
		<PackageReference Include="ExcelDataReader" Version="3.9.0" />
		<PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" ExcludeAssets="runtime" />
		<PackageReference Include="Vanara.Windows.Shell" Version="5.0.7" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\ExControls\ExControls\ExControls.csproj" />
		<ProjectReference Include="..\ToolsCore.Iniss\ToolsCore.Iniss.csproj" />
	</ItemGroup>
	<!-- Rozsirenie navrhara ExControls pre VS (editor kolekcie ExOptionsView.Panels) -->
	<Import Project="..\..\ExControls\ExControls.Designer.targets" />
</Project>
