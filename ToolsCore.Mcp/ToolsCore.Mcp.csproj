<Project Sdk="Microsoft.NET.Sdk">
	<!-- Server MCP pre agentov v procese programu (GVDEditor, GVXEditor): Kestrel na 127.0.0.1, kluc, nastavenie
	     a stranka nastaveni Agenti (MCP). Samostatny projekt - ostatne programy nad ToolsCore ASP.NET Core nepotrebuju. -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>ToolsCore.Mcp</RootNamespace>
		<AssemblyName>ToolsCore.Mcp</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<LangVersion>default</LangVersion>
		<NeutralLanguage>sk</NeutralLanguage>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\ExControls\ExControls\ExControls.csproj" />
		<ProjectReference Include="..\ToolsCore\ToolsCore.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>
