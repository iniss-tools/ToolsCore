<Project Sdk="Microsoft.NET.Sdk">
	<!-- Domena INISS bez WinForms: formaty suborov, jazyk vyrazov, stavovy diagram, TabTab, zvukova banka. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>ToolsCore.Iniss</RootNamespace>
		<AssemblyName>ToolsCore.Iniss</AssemblyName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<LangVersion>default</LangVersion>
	</PropertyGroup>
	<ItemGroup>
		<!-- zaznamy cez staticky Serilog.Log; kam idu, urcuje program (ToolsCore AppLog, server TableSimulator) -->
		<PackageReference Include="Serilog" Version="4.3.0" />
	</ItemGroup>
</Project>
